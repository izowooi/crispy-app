{
  // DeepZ 무료 번역 서버. API 키가 없는 사용자의 번역을 하루 정해진 횟수만큼 대신 처리한다.
  // 비밀 값(ANTHROPIC_API_KEY, OPENAI_API_KEY, APP_SECRET)은 여기 적지 않고 `wrangler secret put` 으로 넣는다.
  "name": "deepz-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "vars": {
    "MODEL": "claude-haiku-5-5",
    "OPENAI_MODEL": "gpt-6.2-sol",
    "DAILY_LIMIT": "10",
    "IP_DAILY_LIMIT": "40",
    "GLOBAL_DAILY_LIMIT": "3000",
    "MAX_CHARS": "5000"
  }
}
